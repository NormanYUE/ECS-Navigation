<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>enable</Nullable>
        <!-- 烘焙 / ORCA 内核需要裸指针访问 World 托管 buffer 与堆分配数组。 -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Ember.Navigation</RootNamespace>
        <AssemblyName>Ember.Navigation</AssemblyName>
        <EmberFrameworkDir Condition="'$(EmberFrameworkDir)' == ''">$(MSBuildThisFileDirectory)../Ember.Framework</EmberFrameworkDir>
        <EmberRuntimeDll Condition="'$(EmberRuntimeDll)' == ''">$(MSBuildThisFileDirectory)../Ember.Package/Runtime/Ember.dll</EmberRuntimeDll>
        <EmberGeneratorDll Condition="'$(EmberGeneratorDll)' == ''">$(MSBuildThisFileDirectory)../Ember.Package/RoslynAnalyzers/Ember.Generator.dll</EmberGeneratorDll>
        <!-- tests/ 是独立测试工程，必须从默认通配项整体排除：只写 Compile Remove 时，
             其文件仍留在 None 里并进入 CandidateAssemblyFiles，而 AssemblySearchPaths
             的顺序是 {CandidateAssemblyFiles};{HintPathFromItem}，于是 Reference 会命中
             tests 输出目录里的旧 DLL，HintPath 形同虚设。 -->
        <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;Editor/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <!-- Ember（框架）仍以发布件引用 —— 框架保持 DLL 包，不随本次改动。
             但需要 Ember ≥ 1.13.0（CreateSizedBuffer）。 -->
        <Reference Include="Ember">
            <HintPath>$(EmberRuntimeDll)</HintPath>
        </Reference>

        <!-- Ember.Core / Ember.Collision 用源码工程引用：三者在同一套源码里，Unity 侧
             同样是源码编译在一起。不要退回引某个包库的 DLL —— 派生模块已经没有独立包库了。 -->
        <ProjectReference Include="..\Ember.Core\Ember.Core.csproj" />
        <ProjectReference Include="..\Ember.Collision\Ember.Collision.csproj" />
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(EmberFrameworkDir)/libs/UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Collections">
            <HintPath>$(EmberFrameworkDir)/libs/Unity.Collections.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Mathematics">
            <HintPath>$(EmberFrameworkDir)/libs/Unity.Mathematics.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- 显式 Burst 策略（EmberJobCompilationMode.Burst）要求编译期可解析 Unity.Burst 类型，
             否则源生成器报 EMBER005。仅编译引用，运行时由 com.unity.burst 包提供。 -->
        <Reference Include="Unity.Burst">
            <HintPath>$(MSBuildThisFileDirectory)Libs~/Unity.Burst.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Analyzer Include="$(EmberGeneratorDll)" />
    </ItemGroup>

    <!-- 仓库根就是 UPM 包根，不再有「同步到另一个仓库」这一步；
         但包内每个资源都必须有 .meta，否则 Unity 在不可变包目录里直接忽略它。
         工具本体在 Ember.Framework/tools/ 下。 -->
    <Target Name="StampPackageMetas" AfterTargets="Build"
            Condition="'$(EmberStampPackageMetas)' == 'true'">
        <Exec Command="python3 &quot;$(EmberFrameworkDir)/tools/stamp-package-metas.py&quot; --package &quot;$(MSBuildThisFileDirectory).&quot; --name com.ember.navigation" />
    </Target>

</Project>
