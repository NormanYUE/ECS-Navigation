<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>enable</Nullable>
        <!-- 烘焙 / ORCA 内核需要裸指针访问 World 托管 buffer 与堆分配数组。 -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Ember.Navigation</RootNamespace>
        <AssemblyName>Ember.Navigation</AssemblyName>
        <EmberFrameworkDir Condition="'$(EmberFrameworkDir)' == ''">$(MSBuildThisFileDirectory)../Ember.Framework</EmberFrameworkDir>
        <EmberRuntimeDll Condition="'$(EmberRuntimeDll)' == ''">$(MSBuildThisFileDirectory)../Ember.Package/Runtime/Ember.dll</EmberRuntimeDll>
        <EmberCoreDll Condition="'$(EmberCoreDll)' == ''">$(MSBuildThisFileDirectory)../Ember.Core.Package/Runtime/Ember.Core.dll</EmberCoreDll>
        <EmberCollisionDll Condition="'$(EmberCollisionDll)' == ''">$(MSBuildThisFileDirectory)../Ember.Collision.Package/Runtime/Ember.Collision.dll</EmberCollisionDll>
        <EmberGeneratorDll Condition="'$(EmberGeneratorDll)' == ''">$(MSBuildThisFileDirectory)../Ember.Package/RoslynAnalyzers/Ember.Generator.dll</EmberGeneratorDll>
        <EmberPackageDir Condition="'$(EmberPackageDir)' == ''">$(MSBuildThisFileDirectory)../Ember.Navigation.Package</EmberPackageDir>
        <EmberDeployPackageBinaries Condition="'$(EmberDeployPackageBinaries)' == ''">false</EmberDeployPackageBinaries>
        <!-- tests/ 是独立测试工程，必须从默认通配项整体排除：只写 Compile Remove 时，
             其文件仍留在 None 里并进入 CandidateAssemblyFiles，而 AssemblySearchPaths
             的顺序是 {CandidateAssemblyFiles};{HintPathFromItem}，于是 Reference 会命中
             tests 输出目录里的旧 DLL，HintPath 形同虚设。 -->
        <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <!-- 三个上游均以发布件引用；上游更新后先发布其包库，再重构建本模块。
             需要 Ember ≥ 1.11.0（ResizeBuffer）与 Ember.Collision ≥ 0.3.0（ShapeQuery 最近点 / 射线查询、body 快照）。 -->
        <Reference Include="Ember">
            <HintPath>$(EmberRuntimeDll)</HintPath>
        </Reference>
        <Reference Include="Ember.Core">
            <HintPath>$(EmberCoreDll)</HintPath>
        </Reference>
        <Reference Include="Ember.Collision">
            <HintPath>$(EmberCollisionDll)</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(EmberFrameworkDir)/libs/UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Collections">
            <HintPath>$(EmberFrameworkDir)/libs/Unity.Collections.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Mathematics">
            <HintPath>$(EmberFrameworkDir)/libs/Unity.Mathematics.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- 显式 Burst 策略（EmberJobCompilationMode.Burst）要求编译期可解析 Unity.Burst 类型，
             否则源生成器报 EMBER005。仅编译引用，运行时由 com.unity.burst 包提供。 -->
        <Reference Include="Unity.Burst">
            <HintPath>$(MSBuildThisFileDirectory)libs/Unity.Burst.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Analyzer Include="$(EmberGeneratorDll)" />
    </ItemGroup>

    <Target Name="DeployPackageDlls" AfterTargets="Build"
            Condition="'$(EmberDeployPackageBinaries)' == 'true'">
        <MakeDir Directories="$(EmberPackageDir)/Runtime"/>
        <Copy SourceFiles="$(TargetPath)"
              DestinationFiles="$(EmberPackageDir)/Runtime/Ember.Navigation.dll"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
