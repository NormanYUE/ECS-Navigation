<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Ember.Navigation.Editor</RootNamespace>
        <AssemblyName>Ember.Navigation.Editor</AssemblyName>
        <EmberFrameworkDir Condition="'$(EmberFrameworkDir)' == ''">$(MSBuildThisFileDirectory)../../Ember.Framework</EmberFrameworkDir>
        <UnityManagedDir Condition="'$(UnityManagedDir)' == ''">/Applications/Unity/Hub/Editor/2022.3.62f2/Unity.app/Contents/Managed</UnityManagedDir>
        <EmberPackageDir Condition="'$(EmberPackageDir)' == ''">$(MSBuildThisFileDirectory)../../Ember.Navigation.Package</EmberPackageDir>
        <EmberDeployPackageBinaries Condition="'$(EmberDeployPackageBinaries)' == ''">false</EmberDeployPackageBinaries>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="bin/**" />
        <Compile Remove="obj/**" />
    </ItemGroup>

    <PropertyGroup>
        <EmberRuntimeDll Condition="'$(EmberRuntimeDll)' == ''">$(MSBuildThisFileDirectory)../../Ember.Package/Runtime/Ember.dll</EmberRuntimeDll>
        <EmberCoreDll Condition="'$(EmberCoreDll)' == ''">$(MSBuildThisFileDirectory)../../Ember.Core.Package/Runtime/Ember.Core.dll</EmberCoreDll>
        <EmberCollisionDll Condition="'$(EmberCollisionDll)' == ''">$(MSBuildThisFileDirectory)../../Ember.Collision.Package/Runtime/Ember.Collision.dll</EmberCollisionDll>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Ember.Navigation.csproj" />
        <Reference Include="Ember">
            <HintPath>$(EmberRuntimeDll)</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Ember.Core">
            <HintPath>$(EmberCoreDll)</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Ember.Collision">
            <HintPath>$(EmberCollisionDll)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="UnityEditor">
            <HintPath>$(UnityManagedDir)/UnityEditor.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(UnityManagedDir)/UnityEngine/UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(UnityManagedDir)/UnityEngine/UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(UnityManagedDir)/UnityEngine/UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Collections">
            <HintPath>$(EmberFrameworkDir)/libs/Unity.Collections.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Unity.Mathematics">
            <HintPath>$(EmberFrameworkDir)/libs/Unity.Mathematics.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- 部署到包库的 Editor/ 目录：Unity 对名为 Editor 的文件夹有特殊规则，
         其下的 DLL 自动只进编辑器程序集，无需 asmdef（与 Ember.Package 同构）。 -->
    <Target Name="DeployEditorDll" AfterTargets="Build"
            Condition="'$(EmberDeployPackageBinaries)' == 'true'">
        <MakeDir Directories="$(EmberPackageDir)/Editor"/>
        <Copy SourceFiles="$(TargetPath)"
              DestinationFiles="$(EmberPackageDir)/Editor/Ember.Navigation.Editor.dll"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
